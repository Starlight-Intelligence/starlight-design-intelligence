{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "starlight.infogenius.character-retrieval.v1",
  "title": "InfoGenius character retrieval contract (request + response)",
  "description": "PROPOSED JSON contract between the InfoGenius casting resolver and the VIS character retrieval interface (frankxai/visual-intelligence issue 91). Reconcile field names with the issue before wiring a live transport. No asset bytes are required; hashes are compared when bytes or a local path are supplied.",
  "$defs": {
    "request": {
      "type": "object",
      "required": ["schema", "request_id", "character_ids", "verify"],
      "properties": {
        "schema": { "const": "starlight.infogenius.character-retrieval-request.v1" },
        "request_id": { "type": "string", "minLength": 1 },
        "character_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" } },
        "verify": { "type": "boolean" },
        "brand": { "type": "string" },
        "purpose": { "type": "string" }
      },
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "required": ["schema", "request_id", "reference_revision", "characters"],
      "properties": {
        "schema": { "const": "starlight.infogenius.character-retrieval-response.v1" },
        "request_id": { "type": "string" },
        "reference_revision": { "type": "string" },
        "fixture": { "type": "boolean" },
        "characters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "status", "lineage"],
            "properties": {
              "id": { "type": "string" },
              "status": { "enum": ["approved-canon", "candidate", "rejected", "vendor-guest", "unavailable"] },
              "lineage": { "type": "string" },
              "class": { "type": "string" },
              "rights_state": { "type": "string" },
              "assets": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["asset_id", "sha256"],
                  "properties": {
                    "asset_id": { "type": "string" },
                    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                    "bytes_base64": { "type": "string" },
                    "path": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
