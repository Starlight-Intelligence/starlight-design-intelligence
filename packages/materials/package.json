{
  "name": "@starlight/materials",
  "version": "0.1.0",
  "description": "Living materials for Next.js 16: liquid glass behind a device gate, paper and ink primitives on shadcn, one state contract.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "src",
    "DESIGN.md",
    "README.md",
    "registry.json"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./gate": "./src/gate/index.ts",
    "./glass": "./src/glass/index.ts",
    "./primitives": "./src/primitives/index.ts",
    "./primitives/*": "./src/primitives/ui/*.tsx",
    "./tokens": "./src/tokens/index.ts",
    "./styles.css": "./src/styles/materials.css",
    "./tokens.css": "./src/tokens/tokens.css",
    "./package.json": "./package.json",
    "./theme.css": "./src/tokens/theme.css"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint:design": "npx --yes @google/design.md lint DESIGN.md",
    "tokens": "npx --yes @google/design.md export DESIGN.md --format css-vars --prefix sl > src/tokens/tokens.css && npx --yes @google/design.md export DESIGN.md --format css-tailwind > src/tokens/theme.css",
    "registry:build": "shadcn build registry.json --output public/r"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "1.53.0",
    "radix-ui": "^1.8.1",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "next": "^16",
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4",
    "three": "^0.186.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "4.22.1",
    "three": "0.186.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
