{
  "name": "@starlight/living-agent-ui",
  "version": "0.1.0-rc.1",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "SOURCE-RIGHTS.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ag-ui": {
      "types": "./dist/ag-ui.d.ts",
      "import": "./dist/ag-ui.js"
    },
    "./copilotkit": {
      "types": "./dist/copilotkit.d.ts",
      "import": "./dist/copilotkit.js"
    },
    "./styles.css": "./dist/agent.css",
    "./a2ui": {
      "types": "./dist/a2ui.d.ts",
      "import": "./dist/a2ui.js"
    },
    "./demo": {
      "types": "./dist/Workbench.d.ts",
      "import": "./dist/Workbench.js"
    },
    "./demo.css": "./dist/demo.css",
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    }
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && cp src/agent.css dist/agent.css && cp src/demo.css dist/demo.css",
    "dev": "vite --host 127.0.0.1 --port 5174",
    "build:demo": "vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "pack:source": "node scripts/package.mjs",
    "test:performance": "node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.4",
    "@ag-ui/core": "1.0.4",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@copilotkit/a2ui-renderer": "1.87.1",
    "@copilotkit/react-core": "1.87.1",
    "@starlight/living-design": "0.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@copilotkit/react-core": {
      "optional": true
    },
    "@copilotkit/a2ui-renderer": {
      "optional": true
    }
  },
  "devDependencies": {
    "@copilotkit/a2ui-renderer": "1.87.1",
    "@copilotkit/react-core": "1.87.1",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/instrument-sans": "5.3.0",
    "@playwright/test": "1.62.1",
    "@starlight/living-design": "file:release/starlight-living-design-0.2.0.tgz",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.0.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "axe-core": "4.10.3",
    "jsdom": "27.2.0",
    "lighthouse": "13.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  },
  "optionalDependencies": {
    "zod3-compat": "npm:zod@3.25.76"
  }
}
