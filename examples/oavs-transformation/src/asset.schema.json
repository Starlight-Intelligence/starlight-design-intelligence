{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:starlight:experimental:transformation-asset:0.1",
  "title": "Experimental transformation sidecar; extension to existing living-design identities",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entity_id", "version", "canon_status", "character_id", "runtime_agent_id", "identity_anchors", "units", "components", "joints", "configurations", "transition", "artifacts", "provenance", "scope"],
  "properties": {
    "schema_version": {"const": "starlight.transformation.asset.v0.1"},
    "entity_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "canon_status": {"const": "noncanonical_experiment"},
    "character_id": {"type": ["string", "null"]},
    "runtime_agent_id": {"type": ["string", "null"]},
    "identity_anchors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "units": {"type": "object", "required": ["length", "angle", "source_up", "delivery_up"], "properties": {"length": {"const": "metre"}, "angle": {"const": "radian"}, "source_up": {"const": "Z"}, "delivery_up": {"const": "Y"}}, "additionalProperties": false},
    "components": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "parent_id", "mesh_ref", "geometry_sha256", "scale"], "properties": {"id": {"type": "string"}, "parent_id": {"type": ["string", "null"]}, "mesh_ref": {"type": ["integer", "null"]}, "geometry_sha256": {"anyOf": [{"type": "string", "pattern": "^[a-f0-9]{64}$"}, {"type": "null"}]}, "scale": {"const": [1,1,1]}}, "additionalProperties": false}},
    "joints": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "type", "source_axis", "delivery_axis", "limits", "phase"], "properties": {"id": {"type": "string"}, "type": {"const": "revolute"}, "source_axis": {"const": [0,1,0]}, "delivery_axis": {"const": [0,0,-1]}, "limits": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}, "phase": {"type": "array", "items": {"type": "number", "minimum": 0, "maximum": 1}, "minItems": 2, "maxItems": 2}}, "additionalProperties": false}},
    "configurations": {"type": "object", "required": ["seed", "bloom"], "additionalProperties": {"type": "object", "required": ["q"], "properties": {"q": {"type": "number", "minimum": 0, "maximum": 1}}, "additionalProperties": false}},
    "transition": {"type": "object", "required": ["from", "to", "duration_s", "curve", "reversal", "dependencies"], "properties": {"from": {"type": "string"}, "to": {"type": "string"}, "duration_s": {"type": "number", "exclusiveMinimum": 0}, "curve": {"const": "clamped-quintic"}, "reversal": {"const": "settled-endpoints-only"}, "dependencies": {"type": "array", "items": {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 2}}}, "additionalProperties": false},
    "artifacts": {"type": "array", "items": {"type": "object", "required": ["path", "sha256", "bytes"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "bytes": {"type": "integer", "minimum": 1}}, "additionalProperties": false}},
    "provenance": {"type": "object", "required": ["method", "approval", "owner_repo", "source_hashes"], "properties": {"method": {"const": "original-procedural-geometry"}, "approval": {"const": "experimental-unapproved"}, "owner_repo": {"type": "string"}, "source_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}, "additionalProperties": false},
    "scope": {"type": "string"}
  }
}
